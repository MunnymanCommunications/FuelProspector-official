{
  "manifest_version": 3,
  "name": "FuelProspector AI",
  "version": "1.0.0",
  "description": "AI-powered sales discovery engine for independent fuel station prospecting",
  "permissions": [
    "geolocation",
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"
  }
}
