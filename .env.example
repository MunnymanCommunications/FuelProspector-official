# Build-time variables. In Coolify, add both with "Build Variable" enabled.

# Get your API key from https://aistudio.google.com/apikey
# Restrict the key to:
#   - HTTP referrers: https://fuel.harveyio.com/* and https://unused.harveyio.com/*
#   - API restriction: Generative Language API only
#   - Quota cap: set a hard daily request ceiling in Google Cloud Console
GEMINI_API_KEY=your_api_key_here

# 4-digit PIN gate for the app (client-side, baked into bundle, not real auth)
APP_PIN=2580

# Required Google Cloud APIs:
#   1. Generative Language API (Gemini) - Must be enabled
#   Grounding tools (googleSearch, googleMaps) bill through this API.
#
# Note: Grounding features may require a paid API plan.
# https://ai.google.dev/gemini-api/docs/grounding
